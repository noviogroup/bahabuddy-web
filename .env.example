# ─── Supabase ───────────────────────────────────────────────────────────
# Shared with the Flutter mobile app (Baha-Buddy-V2/).
# Project ID: cxcfymhoncysyloutvkh

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Keep secret. Used by Edge Function callers and
# the chat API for trip persistence.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Anthropic ──────────────────────────────────────────────────────────
# Required for /api/chat. Server-side only.

ANTHROPIC_API_KEY=sk-ant-your-key-here


# ─── Stripe (C.9) ───────────────────────────────────────────────────────
# Dashboard checkout reuses mobile's `stripe-payment` + `stripe-webhook`
# Edge Functions. Concierge Checkout uses server-side Stripe REST calls.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Server-side only. Required for /api/concierge-checkout.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Server-side only. Required for /api/stripe/concierge-webhook.
# Register a separate Stripe webhook endpoint for concierge orders — do not
# reuse the mobile trip-booking webhook at stripe-webhook Edge Function.
STRIPE_CONCIERGE_WEBHOOK_SECRET=whsec_your_concierge_webhook_secret


# ─── Duffel (Flights) ───────────────────────────────────────────────────
# Legacy flight search provider for the `search_flights` chat tool.
# Server-side only. Without it, Buddy says "flights unavailable" and adapts.
# Token names checked in order: DUFFEL_API_TOKEN, then DUFFEL_API_KEY
# (backward-compat with mobile env).

DUFFEL_API_TOKEN=duffel_test_your_token


# ─── Travel Booking Provider ────────────────────────────────────────────
# Server-side only. Required for /api/booking/flights/*.
# Do not use NEXT_PUBLIC_ for this key.

TRAVEL_BOOKING_API_KEY=your_live_booking_provider_key
LITEAPI_API_KEY=your_live_liteapi_private_key
LITEAPI_PUBLIC_KEY=your_live_liteapi_public_key
TRAVEL_BOOKING_API_BASE_URL=https://api.liteapi.travel/v3.0
TRAVEL_BOOKING_BOOK_BASE_URL=https://book.liteapi.travel/v3.0
TRAVEL_BOOKING_API_AUTH_HEADER=X-API-Key


# ─── Booking Readiness Gate ─────────────────────────────────────────────
# Server-side only. Required on the deployed web runtime before running
# `npm run verify:booking-readiness -- --runtime-url <deployed-web-url>`.
# This protects /api/internal/booking-readiness. Do not expose this to the
# browser and do not reuse a provider API key as the readiness token.

BOOKING_READINESS_TOKEN=generate-a-long-random-readiness-token

# Local verifier convenience only. Optional. Do not set this in client env.
BOOKING_READINESS_RUNTIME_URL=https://your-deployed-web-url.example


# ─── Sanity CMS (C.7) ───────────────────────────────────────────────────
# Optional. Without these vars, the editorial content (BuddyPickCard,
# TravelTipCard, /explore Discover) falls back to hardcoded pools.
# The fallback ALWAYS stays — Sanity is an upgrade, not a dependency.
#
# Setup guide: src/lib/sanity/README.md

NEXT_PUBLIC_SANITY_PROJECT_ID=593u37vh
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01


# ─── Notes ──────────────────────────────────────────────────────────────
# - All NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
#   Anything sensitive must NOT have the NEXT_PUBLIC_ prefix.
# - The Stripe webhook URL (set in Stripe Dashboard) must point at the
#   Supabase Edge Function: https://cxcfymhoncysyloutvkh.supabase.co/functions/v1/stripe-webhook
# - Run `supabase/enable_trip_realtime.sql` in the Supabase SQL Editor once
#   to enable B.13 Realtime trip updates. Idempotent.
