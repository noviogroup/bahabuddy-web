# ─── Supabase ───────────────────────────────────────────────────────────
# Shared with the Flutter mobile app (Baha-Buddy-V2/).
# Project ID: cxcfymhoncysyloutvkh

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Keep secret. Used by Edge Function callers and
# the chat API for trip persistence.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Anthropic ──────────────────────────────────────────────────────────
# Required for /api/chat. Server-side only.

ANTHROPIC_API_KEY=sk-ant-your-key-here


# ─── Stripe (C.9) ───────────────────────────────────────────────────────
# Required for /dashboard/checkout. Without this var, checkout shows a
# friendly "not configured" screen instead of crashing — the Book CTA
# is hidden on the trip detail page and chat Summary card too.
#
# The web reuses mobile's `stripe-payment` Edge Function for PaymentIntent
# creation and the `stripe-webhook` Edge Function for status updates.
# No new server-side Stripe key needed — the mobile-era setup carries.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key


# ─── Duffel (Flights) ───────────────────────────────────────────────────
# Required for the `search_flights` chat tool. Server-side only.
# Without it, Buddy says "flights unavailable" and adapts.
# Token names checked in order: DUFFEL_API_TOKEN, then DUFFEL_API_KEY
# (backward-compat with mobile env).

DUFFEL_API_TOKEN=duffel_test_your_token


# ─── Sanity CMS (C.7) ───────────────────────────────────────────────────
# Optional. Without these vars, the editorial content (BuddyPickCard,
# TravelTipCard, /explore Discover) falls back to hardcoded pools.
# The fallback ALWAYS stays — Sanity is an upgrade, not a dependency.
#
# Setup guide: src/lib/sanity/README.md

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01


# ─── Notes ──────────────────────────────────────────────────────────────
# - All NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
#   Anything sensitive must NOT have the NEXT_PUBLIC_ prefix.
# - The Stripe webhook URL (set in Stripe Dashboard) must point at the
#   Supabase Edge Function: https://cxcfymhoncysyloutvkh.supabase.co/functions/v1/stripe-webhook
# - Run `supabase/enable_trip_realtime.sql` in the Supabase SQL Editor once
#   to enable B.13 Realtime trip updates. Idempotent.
